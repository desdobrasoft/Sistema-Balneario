# ------------------------------------------------------------------------------
# AMBIENTE: DESENVOLVIMENTO (.env.example)
# Execução: npm run start:dev (Terminal)
# Banco de Dados: Exposto pelo docker-compose local na porta 5432
# ------------------------------------------------------------------------------

# Banco de Dados
POSTGRES_USER=tech_wall
POSTGRES_PASSWORD=techwall@admin123
POSTGRES_DB=tech_wall
DATABASE_URL="postgresql://tech_wall:techwall%40admin123@localhost:5432/tech_wall?schema=public"

# Autenticação JWT e Sessão
JWT_SECRET="dev-secret-key-do-not-use-in-prod"
JWT_EXPIRATION="24h"
SESSION_ABSOLUTE_EXPIRATION="30d"

# Configuração de Cookies
COOKIE_SAME_SITE="Lax"
COOKIE_SECURE=false

# Porta
PORT=3000

# Seed
ADMIN_USER="admin"
ADMIN_PASSWORD="admin123"
