# ------------------------------------------------------------------------------
# AMBIENTE: PRODUÇÃO (.env.production.example)
# Execução: docker-compose.yaml (VPS via HTTPS)
# Banco de Dados: Comunicação interna no docker network via host 'db'
# NOTA: Em produção real, esses valores virão de Docker Secrets / Vaults
# ------------------------------------------------------------------------------

JWT_EXPIRATION="24h"
SESSION_ABSOLUTE_EXPIRATION="30d"

# Configuração de Cookies
# Obrigatório SameSite=None e Secure=true em produção se frontend/backend
# estiverem em domínios/subdomínios diferentes via HTTPS.
# Se estiverem sob o MESMO domínio, SameSite=Strict e Secure=true é mais seguro.
COOKIE_SAME_SITE="Strict"
COOKIE_SECURE=true

# Porta
PORT=3000


