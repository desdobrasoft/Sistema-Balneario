# ------------------------------------------------------------------------------
# AMBIENTE: LOCAL STANDALONE (.env.local.example)
# Execução: docker-compose-local.yaml (Docker Network)
# Banco de Dados: Comunicação interna no docker network via host 'db'
# ------------------------------------------------------------------------------

# Banco de Dados
POSTGRES_USER=tech_wall
POSTGRES_PASSWORD=techwall@admin123
POSTGRES_DB=tech_wall
DATABASE_URL="postgresql://tech_wall:techwall%40admin123@db:5432/tech_wall?schema=public"

# Autenticação JWT e Sessão
JWT_SECRET="local-docker-secret-key-do-not-use-in-prod"
JWT_EXPIRATION="24h"
SESSION_ABSOLUTE_EXPIRATION="30d"

# Configuração de Cookies
COOKIE_SAME_SITE="Lax"
COOKIE_SECURE=false

# Porta
PORT=3000

# Seed
ADMIN_USER="admin"
ADMIN_PASSWORD="admin123"
