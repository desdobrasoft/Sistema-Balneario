# Banco de Dados (Credenciais usadas pelo Postgres via Docker)
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=your_database_name

# URL de conexão para o Prisma
# Nota: Para rodar via docker-compose, use o host 'db'
# Para rodar localmente no seu host via npm start, troque 'db' por 'localhost'
DATABASE_URL="postgresql://your_postgres_user:your_postgres_password@db:5432/your_database_name?schema=public"

# Autenticação JWT
JWT_SECRET="your_jwt_secret_key_here"
JWT_EXPIRATION="5h"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_key_here"
JWT_REFRESH_EXPIRATION="6d"

# Porta da Aplicação
PORT=3000

# Seed Administrator
ADMIN_USER="your_admin_user"
ADMIN_PASSWORD="your_admin_password"
